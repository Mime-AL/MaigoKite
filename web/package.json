{
  "name": "nanamigopher-web",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vite build --config electron.vite.config.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write src/",
    "electron:dev": "npm run electron:compile && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:compile": "vite build --config electron.vite.config.ts",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "npm run build && electron .",
    "test:run": "vitest run"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dompurify": "^3.4.15",
    "element-plus": "^2.4.0",
    "marked": "^18.0.13",
    "pinia": "^2.1.0",
    "tailwindcss": "^3.4.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/ui": "^1.1.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.5.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.1.0",
    "sass": "^1.69.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.1.0",
    "vue-tsc": "^2.2.12",
    "wait-on": "^7.2.0"
  }
}
